<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>1.0.2.43</Version>
    <Company>SurgeLink</Company>
    <Product>SurgeLink</Product>
    <Copyright>Copyright (c) SurgeLink contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Even when a build relocates intermediates (agent isolation via ArtifactsPath),
         the project-local obj/bin folders must never be globbed as source. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Keep the build quiet about style-only rules; correctness rules stay on. -->
    <NoWarn>$(NoWarn);CA1416;CA1848;CA2007;CA1716;CA1873;CA1805;CA1859;CA1861;CA1305;CA1822;CA1062;CA1819;CA1002;CA1054;CA1056</NoWarn>
  </PropertyGroup>
</Project>
