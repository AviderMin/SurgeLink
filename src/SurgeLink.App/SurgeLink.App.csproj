<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19044.0</TargetPlatformMinVersion>
    <RootNamespace>SurgeLink.App</RootNamespace>
    <AssemblyName>SurgeLink</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="GenerateApplicationIcon" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)\..\..\docs\LOGO.png;$(MSBuildProjectDirectory)\..\..\tools\make-icon.ps1"
          Outputs="$(MSBuildProjectDirectory)\Assets\AppIcon.ico">
    <Exec Command="powershell -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\..\tools\make-icon.ps1&quot;" />
  </Target>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\LOGO.png" Link="Assets\AppLogo.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\SystemIcons\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.UI.Reactor" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SurgeLink.Core\SurgeLink.Core.csproj" />
    <ProjectReference Include="..\SurgeLink.Terminal\SurgeLink.Terminal.csproj" />
    <ProjectReference Include="..\SurgeLink.Protocols.Demo\SurgeLink.Protocols.Demo.csproj" />
    <ProjectReference Include="..\SurgeLink.Protocols.Ssh\SurgeLink.Protocols.Ssh.csproj" />
    <ProjectReference Include="..\SurgeLink.Protocols.Telnet\SurgeLink.Protocols.Telnet.csproj" />
    <ProjectReference Include="..\SurgeLink.Protocols.Serial\SurgeLink.Protocols.Serial.csproj" />
  </ItemGroup>

  <!-- The unpackaged WinUI publish pipeline can omit the app's own PRI.
       It is required at startup even when all referenced-library PRIs exist. -->
  <Target Name="IncludeApplicationPriInPublish" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
           Text="The application resource index is missing: $(TargetDir)$(AssemblyName).pri" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri"
                             RelativePath="$(AssemblyName).pri"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
