param(
    [switch]$ValidateOnly,
    [switch]$TrustCertificateOnly
)

$ErrorActionPreference = 'Stop'
try {
    $packagePath = Join-Path $PSScriptRoot '__PACKAGE_NAME__'
    $certificatePath = Join-Path $PSScriptRoot 'SurgeLink-Development.cer'
    if ((Get-FileHash -LiteralPath $packagePath -Algorithm SHA256).Hash -ne '__PACKAGE_HASH__') {
        throw 'APPX checksum mismatch. Extract the original ZIP again.'
    }
    $certificate = [System.Security.Cryptography.X509Certificates.X509Certificate2]::new($certificatePath)
    try {
        if ($certificate.Thumbprint -ne '__CERT_THUMBPRINT__') {
            throw 'The certificate does not match this release.'
        }
        if ((Get-Date) -lt $certificate.NotBefore -or (Get-Date) -gt $certificate.NotAfter) {
            throw 'The signing certificate is not currently valid. Check the system clock.'
        }
    }
    finally { $certificate.Dispose() }

    if ($ValidateOnly) {
        Write-Output 'Package checksum and signing certificate validated. No changes made.'
        return
    }

    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = [Security.Principal.WindowsPrincipal]::new($identity)
    $isAdministrator = $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    $trustPath = 'Cert:\LocalMachine\TrustedPeople\__CERT_THUMBPRINT__'
    if ($TrustCertificateOnly) {
        if (!$isAdministrator) { throw 'Administrator permission is required for certificate trust.' }
        Import-Certificate -FilePath $certificatePath -CertStoreLocation 'Cert:\LocalMachine\TrustedPeople' | Out-Null
        exit 0
    }

    if (!(Test-Path -LiteralPath $trustPath)) {
        Write-Host 'This development build needs its certificate in Local Machine / Trusted People.'
        Write-Host 'Approve the Windows administrator prompt to trust this release.'
        if ($isAdministrator) {
            Import-Certificate -FilePath $certificatePath -CertStoreLocation 'Cert:\LocalMachine\TrustedPeople' | Out-Null
        }
        else {
            # Elevate only certificate import, keeping app installation under the
            # original user even when UAC uses another administrator account.
            $arguments = '-NoProfile -File "' + $PSCommandPath + '" -TrustCertificateOnly'
            $process = Start-Process -FilePath (Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe') `
                -ArgumentList $arguments -Verb RunAs -WindowStyle Hidden -Wait -PassThru
            if ($process.ExitCode -ne 0) { throw 'Certificate import failed or was cancelled.' }
        }
    }
    if (!(Test-Path -LiteralPath $trustPath)) { throw 'The certificate is not trusted on this machine.' }
    Add-AppxPackage -Path $packagePath -ErrorAction Stop
    Write-Host 'SurgeLink installed successfully. Open SurgeLink from the Start menu.' -ForegroundColor Green
}
catch {
    Write-Error $_ -ErrorAction Continue
    exit 1
}
